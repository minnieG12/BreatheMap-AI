# Copy this file to .env only if you want the app to prefill these settings.
# These values are configuration, not credentials. Never put access keys here.
AWS_S3_BUCKET=your-globally-unique-bucket-name
AWS_S3_PREFIX=breathemap-ai
AWS_DEFAULT_REGION=ap-south-1
# Optional: must match a profile stored in your local AWS config/credentials files.
# AWS_PROFILE=breathemap-ai
